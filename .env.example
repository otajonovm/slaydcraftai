# Telegram bot tokeni (@BotFather)
BOT_TOKEN=123456789:AAAA-your-telegram-bot-token

# Google Gemini API kaliti (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key

# Asosiy model va zaxira modellar (vergul bilan)
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-2.5-flash

# Adminlar Telegram ID lari (vergul bilan): /stats, /give, cheklarni tasdiqlash
ADMIN_IDS=
# To'lov cheklari yuboriladigan chat: admin shaxsiy ID si yoki guruh ID (-100...).
# Bo'sh bo'lsa birinchi admin ID ishlatiladi.
ADMIN_CHAT_ID=

# Bir vaqtda bajariladigan og'ir generatsiyalar soni
MAX_CONCURRENT_JOBS=3

# ---------------- Billing ----------------
# Yangi foydalanuvchiga beriladigan bepul kreditlar (watermark bilan)
FREE_CREDITS_ON_START=1
# Har bir taklif qilingan do'st uchun beriladigan bepul kredit
REFERRAL_BONUS_CREDITS=1
# Karta orqali to'lov rekvizitlari
PAYMENT_CARD_NUMBER=8600 **** **** 1234
PAYMENT_CARD_HOLDER=Ism Familiya
# Qo'llab-quvvatlash uchun Telegram username (@ belgisiz)
SUPPORT_USERNAME=
# Bepul generatsiyalar oxirgi sahifasidagi belgi
WATERMARK_TEXT=SlideCraft AI orqali tayyorlandi — @slaydreferat_aibot

# ---------------- Click / Payme (kelajak uchun) ----------------
CLICK_ENABLED=false
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
PAYME_ENABLED=false
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=

# Ma'lumotlar bazasi. DATABASE_URL (PostgreSQL, Heroku avtomatik qo'yadi) bo'lsa u ishlatiladi,
# aks holda DATABASE_PATH dagi lokal SQLite fayl.
DATABASE_URL=
# Bir nechta bot bitta PostgreSQL bazani ishlatsa, har biriga alohida schema bering (masalan: bot2).
# Bo'sh bo'lsa "public" ishlatiladi.
DB_SCHEMA=
DATABASE_PATH=data/slidecraft.db
TEMP_DIR=data/tmp

# LibreOffice yo'li (ixtiyoriy). Bo'sh bo'lsa avtomatik qidiriladi,
# topilmasa PDF reportlab orqali yasaladi.
LIBREOFFICE_PATH=

LOG_LEVEL=INFO
